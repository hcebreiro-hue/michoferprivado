# Copia este archivo a ".env" y completa con los datos de tu proyecto Supabase.
# Los valores se leen desde src/lib/supabase.ts (usando expo-constants / process.env).
# Si dejas estos valores vacíos, la app funcionará en "modo demo" con datos locales.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
