{
  "expo": {
    "name": "Senda",
    "slug": "Mi-Chofer-Privado",
    "version": "2.0.2",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "michoferprivado",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michoferprivado.app"
    },
    "android": {
      "package": "com.michoferprivado.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "./plugins/withBuildStamp",
      "./plugins/withReleaseSigning",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Senda lee tus contactos solo para que elijas al cliente de un viaje."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85430fc5-45e1-47d6-8010-054fcb48e7c2"
      }
    }
  }
}
